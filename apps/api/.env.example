# Spec §21.1 (Örnek Ortam Değişkenleri) — tam liste burada, ama her biri kendi ADIM'ında
# koda bağlanıyor. Şu an DATABASE_URL (ADIM 2), REDIS_URL + JWT_* (ADIM 3) kullanılıyor.

# ADIM 2 — Veritabanı (Prisma / PostgreSQL 16 + PostGIS)
DATABASE_URL="postgresql://user:password@localhost:5432/guzelkabir?schema=public"

# ADIM 3 — Auth: refresh token rotasyon state'i (spec §2.2 "Redis: cache + queue + oturum")
REDIS_URL="redis://localhost:6379"

# ADIM 3 — Auth (JWT access 15dk + refresh 7 gün, httpOnly rotasyonlu)
JWT_ACCESS_SECRET="dev-only-change-me-access"
JWT_REFRESH_SECRET="dev-only-change-me-refresh"

# ADIM 3 — apps/web dev origin(leri), virgülle ayrılmış (refresh cookie CORS credentials için)
CORS_ORIGIN="http://localhost:3000,http://localhost:3005"

# ADIM 6 — Ödeme: iyzico (Stripe/PayPal Türkiye'de kurulu şirketlere production
# hesabı açmıyor — bkz. CLAUDE.md "Payment provider: iyzico, not Stripe").
# Bu placeholder'larla /payments/intent gerçek bir iyzico API çağrısı yapmayı
# DENER ve kimlik doğrulama hatasıyla başarısız olur (beklenen). Gerçek
# sandbox/production anahtarlarını kendiniz ekleyin (bkz. HANDOVER.md §6.7 —
# aynı "assistant'a gösterilmez" protokolü Stripe'tan devralındı).
IYZICO_API_KEY="sandbox-placeholder-api-key"
IYZICO_SECRET_KEY="sandbox-placeholder-secret-key"
IYZICO_URI="https://sandbox-api.iyzipay.com"
# iyzico Checkout Form'un ödeme sonrası POST ile döneceği backend adresi —
# PaymentsController.handleCallback bunu işleyip müşteriyi FRONTEND_URL'e
# yönlendirir. Gerçek bir dağıtımda bu, apps/api'nin genel erişilebilir
# adresi olmalı (localhost, iyzico'nun sunucularından ulaşılamaz — ngrok vb.
# bir tünel olmadan yerel geliştirmede callback testi yapılamaz, webhook'un
# aynı standart sınırlaması, bkz. CLAUDE.md).
IYZICO_CALLBACK_URL="http://localhost:3001/api/v1/payments/callback"
FRONTEND_URL="http://localhost:3000"

# ADIM 7 — Kanıt doğrulama: AWS S3 (eu-central-1), DigitalOcean Spaces DEĞİL —
# spec §8.2'nin 2 yıllık WORM (Object Lock) gereksinimini yalnızca S3
# karşılıyor (bkz. CLAUDE.md "Evidence verification system"). Bucket'ta
# Object Lock, bucket OLUŞTURULURKEN etkinleştirilmiş olmalı (sonradan
# eklenemez) — Compliance mode, 2 yıl varsayılan saklama.
AWS_ACCESS_KEY_ID="placeholder-access-key"
AWS_SECRET_ACCESS_KEY="placeholder-secret-key"
AWS_REGION="eu-central-1"
S3_EVIDENCE_BUCKET="guzelkabir-evidence-placeholder"
# Canlı S3/Object Lock DOĞRULAMA testleri için ayrı bir bucket — S3_EVIDENCE_BUCKET
# (prod, gerçek müşteri kanıt fotoğrafları + 2 yıl WORM) asla test verisi yazmak
# için kullanılmamalı (bkz. CLAUDE.md "Evidence verification system" — canlı
# checksum-fix doğrulaması yanlışlıkla prod bucket'a yazmıştı). Bu değişken
# henüz boş: gerçek staging bucket'ı (Object Lock'suz veya kısa/self-expiring
# retention'lı) kullanıcı AWS konsolunda oluşturup buraya ekleyecek.
S3_EVIDENCE_STAGING_BUCKET=""
# CloudFront kurulana kadar boş bırakılabilir — StorageService.getPublicUrl
# bu durumda ham (muhtemelen private/erişilemez) bir S3 URL'ine düşer, yalnızca
# kayıt/referans amaçlı (bkz. src/storage/storage.service.ts yorumu).
EVIDENCE_CDN_BASE_URL=""
# spec §8.1: "varsayılan tolerans: 150 metre — mezarlık büyüklüğüne göre
# yapılandırılabilir". cemeteries.geotag_tolerance_m NULL olduğunda bu
# değere düşülür (bkz. schema.prisma Cemetery.geotagToleranceM yorumu).
GEOTAG_DEFAULT_TOLERANCE_M="150"

# Bildirimler (spec §9) — gerçek entegrasyon.
#
# SMS: Netgsm (TR yerel) — REST v2 JSON API, HTTP Basic Auth. NETGSM_USERNAME/
# NETGSM_PASSWORD, ana panel şifreniz DEĞİL — Netgsm panelinden ayrıca
# oluşturulan bir "API alt kullanıcısı" kimlik bilgileridir. NETGSM_MSGHEADER,
# panelde önceden onaylatmanız gereken gönderici başlığı/adı ("başlık onayı" —
# birkaç iş günü sürebilir). Spec §3, diaspora için ayrıca Twilio da öngörüyor
# (bkz. CLAUDE.md "Before going live") — kullanıcı kararıyla bu fazda kapsam
# dışı bırakıldı, yalnızca Netgsm (TR) uygulanıyor.
NETGSM_USERNAME=""
NETGSM_PASSWORD=""
NETGSM_MSGHEADER=""

# E-posta: Postmark (spec §3'ün "Postmark veya SendGrid" seçeneğinden
# kullanıcı kararıyla Postmark seçildi — transaksiyonel odaklı, daha basit
# kurulum). Postmark panelinden bir Server oluşturup Server API Token'ı buraya
# ekleyin; POSTMARK_FROM_EMAIL, Postmark'ta doğrulamış olmanız gereken
# (SPF/DKIM/DMARC DNS kayıtları) gönderici alan adına ait bir adres olmalı.
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_EMAIL=""

# WhatsApp: kullanıcı kararıyla bu fazda ERTELENDİ (Meta Business doğrulaması +
# şablon mesaj onayı ayrı, yavaş bir süreç — bkz. CLAUDE.md "Before going
# live"). Notification satırları channel='whatsapp' ile 'queued' yazılıyor
# ama hiçbir gerçek gönderim yapılmıyor (bkz. NotificationsService yorumu).
WHATSAPP_BUSINESS_TOKEN=""

# ADIM 16 — İzleme
SENTRY_DSN=""

# ADIM 4 — field_partners.national_id_encrypted için AES-256-GCM anahtarı
# (bkz. common/crypto/national-id.crypto.ts). Gerçek bir KMS servisi değil —
# env değişkeni ham simetrik anahtar gibi kullanılıyor; ADIM 9'da gerçek bir
# KMS'e (AWS KMS/Doppler) taşınmalı. Prod'da mutlaka rastgele, uzun bir değer.
KMS_KEY_ID_PII="dev-only-change-me-kms-key"

# ADIM 10 — Mezarlık autocomplete / harita pin
GOOGLE_MAPS_API_KEY=""
